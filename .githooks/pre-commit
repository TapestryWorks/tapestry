#!/usr/bin/env bash
set -euo pipefail

# Run at the workspace root regardless of the directory used for git commit.
cd "$(git rev-parse --show-toplevel)"

# Only format commits containing Rust source changes.
staged_rs=()
while IFS= read -r -d '' path; do
  staged_rs+=("$path")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.rs')

if (("${#staged_rs[@]}" == 0)); then
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo is required to format Rust files." >&2
  exit 1
fi

# Never stage unrelated or partially staged edits without the author's consent.
if ! git diff --quiet -- '*.rs'; then
  echo "pre-commit: unstaged Rust changes found; stage or stash them first." >&2
  echo "pre-commit: refusing to mix unstaged changes into this commit." >&2
  exit 1
fi

echo "pre-commit: running cargo fmt --all"
cargo fmt --all

# cargo fmt operates on the workspace, not only staged files. Do not silently
# include formatting changes from unrelated files in the commit.
while IFS= read -r -d '' path; do
  found=false
  for staged in "${staged_rs[@]}"; do
    if [[ "$path" == "$staged" ]]; then
      found=true
      break
    fi
  done
  if [[ "$found" != true ]]; then
    echo "pre-commit: cargo fmt changed an unstaged file: $path" >&2
    echo "pre-commit: review that change and stage it explicitly." >&2
    exit 1
  fi
done < <(git diff --name-only -z -- '*.rs')

# The original staged Rust files had no unstaged changes on entry, so staging
# their formatted contents cannot accidentally include unrelated local edits.
git add -- "${staged_rs[@]}"
cargo fmt --all -- --check
echo "pre-commit: Rust formatting passed"
